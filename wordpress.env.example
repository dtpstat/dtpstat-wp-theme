# Пример .env для уже установленного WordPress (это НЕ конфиг Docker Compose).
# Скопируйте значения в .env рядом с корнем WordPress (вне document root),
# либо в корень WordPress при условии запрета HTTP-доступа к .env.
# DTP_FRONTEND_URL — страницы /dtp/<id>/details/.
DTP_FRONTEND_URL=https://fe.dtp-stat.ru
# Главная карта — независимый URL (если отсутствует, берётся DTP_FRONTEND_URL).
DTP_MAP_URL=https://fp.dtp-stat.ru
#
# Остальные публичные ссылки темы.
# При отсутствии соответствующего ключа ссылка не выводится.
DTP_CONTACT_TELEGRAM_URL=https://t.me/shehovsov_md
DTP_CONTACT_TELEGRAM_LABEL=@shehovsov_md
DTP_CONTACT_EMAIL=dtp.stat@gmail.com
DTP_SOCIAL_TELEGRAM_URL=https://t.me/dtp_stat
DTP_SOCIAL_X_URL=https://twitter.com/dtp_stat
DTP_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/dtp_stat
DTP_SOCIAL_PATREON_URL=https://patreon.com/crash_map
DTP_SOCIAL_BOOSTY_URL=https://boosty.to/dtp-stat
